# ── App ──
APP_NAME=SmartLight
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://109.111.53.197

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=smartlight
DB_USERNAME=smartlight
DB_PASSWORD=ganti_password_db_ini
DB_ROOT_PASSWORD=ganti_root_password_ini
DB_USER=smartlight

# ── Session & Cache via Redis ──
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Redis ──
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Logging ──
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Device Authentication ──
DEVICE_API_KEY=smartlight-esp32-2026-secret
